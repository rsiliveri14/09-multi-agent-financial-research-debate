# Application
APP_NAME=financial-research-debate
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8009
CORS_ORIGINS=http://localhost:5179,http://127.0.0.1:5179,http://localhost:8090

# Store: memory (tests/demo without Docker) or postgres (compose/k8s)
STORE_BACKEND=memory

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://debate:debate@localhost:5439/debate
DATABASE_URL_SYNC=postgresql://debate:debate@localhost:5439/debate

# Redis (optional run-status cache)
REDIS_URL=redis://localhost:6389/0

# Auth: comma-separated role:token pairs. Never use these values in production.
API_TOKENS=analyst:dev-analyst-token,admin:dev-admin-token

# LLM provider. heuristic is the documented local adapter (no API key).
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_REPAIR_ATTEMPTS=2

# Agent execution policy
MAX_ITERATIONS=12
MAX_WALL_CLOCK_SECONDS=45
MAX_TOKEN_BUDGET=24000
MAX_DEBATE_ROUNDS=2
TOOL_TIMEOUT_SECONDS=6
TOOL_MAX_RETRIES=2

# Retrieval
RETRIEVAL_TOP_K=12
RERANK_TOP_K=8
RRF_K=60
HYBRID_LEXICAL_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.45
EMBEDDING_BACKEND=hashing
EMBEDDING_DIM=384
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_BACKEND=heuristic
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Cost model (USD) used for estimates when the provider does not return usage cost
INPUT_TOKEN_USD=0.00000015
OUTPUT_TOKEN_USD=0.0000006

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30

# Compose: host port for the API container (default 8009). Set 8010 if make run-api already binds 8009.
# API_HOST_PORT=8010

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=financial-research-debate
OTEL_CONSOLE=false
METRICS_ENABLED=true
